# CMSC 125 Lab 3 - Concurrent Banking System
# Makefile


# ----------------------------------------------------------
# Compiler
# ----------------------------------------------------------
CC = gcc

# ----------------------------------------------------------
# Directories
# ----------------------------------------------------------
SRC_DIR = src
INC_DIR = include
OBJ_DIR = obj
BIN_DIR = bin
TEST_DIR = tests

# ----------------------------------------------------------
# Executable Name
# ----------------------------------------------------------
TARGET = $(BIN_DIR)/bankdb

# ----------------------------------------------------------
# Source Files
# ----------------------------------------------------------
SRCS = $(wildcard $(SRC_DIR)/*.c)

# Convert src/file.c -> obj/file.o
OBJS = $(patsubst $(SRC_DIR)/%.c,$(OBJ_DIR)/%.o,$(SRCS))

# ----------------------------------------------------------
# Compiler Flags
# ----------------------------------------------------------
COMMON_FLAGS = -I$(INC_DIR) -pthread -Wall -Wextra

# Production Build
CFLAGS = $(COMMON_FLAGS) -O2

# Debug Build + ThreadSanitizer
DEBUG_FLAGS = $(COMMON_FLAGS) -g -fsanitize=thread

# ----------------------------------------------------------
# Default Target
# ----------------------------------------------------------
all: $(TARGET)

# ----------------------------------------------------------
# Link Object Files
# ----------------------------------------------------------
$(TARGET): $(OBJS)
	@mkdir -p $(BIN_DIR)
	$(CC) $(CFLAGS) $^ -o $@

# ----------------------------------------------------------
# Compile Source Files
# ----------------------------------------------------------
$(OBJ_DIR)/%.o: $(SRC_DIR)/%.c
	@mkdir -p $(OBJ_DIR)
	$(CC) $(CFLAGS) -c $< -o $@

# ----------------------------------------------------------
# Debug Build
# ----------------------------------------------------------
debug: clean
	@mkdir -p $(OBJ_DIR)
	@mkdir -p $(BIN_DIR)

	@for file in $(SRCS); do \
		obj="$(OBJ_DIR)/$$(basename $$file .c).o"; \
		$(CC) $(DEBUG_FLAGS) -c $$file -o $$obj; \
	done

	$(CC) $(DEBUG_FLAGS) $(OBJS) -o $(TARGET)

# ----------------------------------------------------------
# Run Program
# ----------------------------------------------------------
run: all
	./$(TARGET)

# ==========================================================
# INDIVIDUAL TEST CASES
# ==========================================================

# ----------------------------------------------------------
# Test 1: Simple Sequential Operations
# ----------------------------------------------------------
test1: all
	@echo "========================================="
	@echo "Running Test 1: Simple Transactions"
	@echo "========================================="
# 	setarch -R ./$(TARGET) \
# 		--accounts=$(TEST_DIR)/accounts.txt \
# 		--trace=$(TEST_DIR)/trace_simple.txt \
# 		--deadlock=prevention

	./$(TARGET) \
		--accounts=$(TEST_DIR)/accounts.txt \
		--trace=$(TEST_DIR)/trace_simple.txt \
		--deadlock=prevention

